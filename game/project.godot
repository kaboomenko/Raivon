; Raivon: Territory Wars — Godot 4 client (owner decision 33: native app, reference look)
config_version=5

[application]

boot_splash/image="res://assets/splash/splash.png"
boot_splash/bg_color=Color(0.03, 0.06, 0.16, 1)
boot_splash/fullsize=true
boot_splash/minimum_display_time=1200
config/name="Raivon: Territory Wars"
config/version="0.7.0"
run/main_scene="res://scenes/main.tscn"
config/icon="res://assets/icon/icon_512.png"
config/features=PackedStringArray("4.5", "Forward Plus")

[display]
window/size/viewport_width=941
window/size/viewport_height=1672
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true

[internationalization]

locale/translations=PackedStringArray("res://locale/strings.ru.translation", "res://locale/strings.en.translation")
locale/fallback="en"
